# Copie para .env (o .env NÃO vai para o git).
# No GitHub Actions estes valores são cadastrados em Settings > Secrets and variables > Actions.

# --- Onde fica o lake --------------------------------------------------------------
# Desenvolvimento local, sem nuvem: uma pasta
MTG_LAKE=./data/lake
# Produção (Cloudflare R2 ou AWS S3): s3://<bucket>
# MTG_LAKE=s3://mtg-lake

# --- Credenciais S3 / R2 (só quando MTG_LAKE começa com s3://) ---------------------
# Cloudflare R2
# S3_ENDPOINT=<ACCOUNT_ID>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_URL_STYLE=path
# AWS S3
# S3_ENDPOINT=s3.amazonaws.com
# S3_REGION=us-east-1
# S3_URL_STYLE=vhost
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# --- Scryfall ------------------------------------------------------------------------
# Identifique seu app (regra da API): nome/versão + contato
SCRYFALL_USER_AGENT=MTGLakehouse/1.0 (seu-email@exemplo.com)

# --- Opcionais -----------------------------------------------------------------------
# MTG_DUCKDB_PATH=./data/mtg.duckdb
# MTG_ESTADO_PATH=./data/estado.json
# MTG_RETENCAO_BRONZE_DIAS=14
